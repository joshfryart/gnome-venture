Options -Indexes
<FilesMatch "\.(md|sql|sqlite|sqlite-wal|sqlite-shm|log|bak)$">
  Require all denied
</FilesMatch>

# v0.8.8: faster pages (search engines reward speed). Pictures, styles and scripts are cached; file names carry ?v= so updates still show at once.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml text/plain image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
</IfModule>
